# Password del pannello admin (obbligatoria)
ADMIN_PASSWORD=cambiami

# Segreto per firmare i cookie di sessione (consigliato: stringa casuale lunga)
# Se vuoto viene generato ad ogni avvio e gli admin dovranno rifare il login.
SESSION_SECRET=

# Porta HTTP del server
PORT=8080

# Cartella dati (database + upload). In Docker e' /app/data
# DATA_DIR=./data

# Dimensione massima upload media in MB
MAX_UPLOAD_MB=300
